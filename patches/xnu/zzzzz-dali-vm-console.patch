+/* DALI_FINAL_CONSOLE_MAP_BEGIN
+ * Reserve two empty 4 KiB-granule L2 blocks in the low-globals/kernel gap.
+ * This follows the earlier ios-sweet final-console mapping approach, with
+ * explicit type, allocation and gap checks. Never allocate or replace tables.
+ * Keep the same Device-nGnRnE attributes as the outgoing identity alias.
+ */
+static vm_offset_t
+dali_console_map_final(void)
+{
+	if (!dali_bootstrap_console) {
+		return 0;
+	}
+#if !defined(__ARM_16K_PG__) && !XNU_MONITOR && !__ARM_KERNEL_PROTECT__
+	/* VM_MIN_KERNEL_ADDRESS is 64 GiB below low globals on this native ABI. */
+	const vm_map_address_t va = LOW_GLOBAL_BASE_ADDRESS + ARM_TT_L2_SIZE;
+	if (dali_bootstrap_console != 0xAEC0F000UL ||
+	    va + 2 * ARM_TT_L2_SIZE > gVirtBase ||
+	    (gPhysBase < 0xAF000000ULL && real_avail_end > 0xAEC00000ULL)) {
+		/* Never introduce a Device alias of the managed write-back aperture. */
+		goto unavailable;
+	}
+	tt_entry_t root = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	if ((root & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) !=
+	    (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		goto unavailable;
+	}
+	pmap_paddr_t table_pa = root & ARM_TTE_TABLE_MASK;
+	if (table_pa < gPhysBase || table_pa >= avail_start ||
+	    avail_start - table_pa < ARM_PGBYTES) {
+		goto unavailable;
+	}
+	tt_entry_t *table = (tt_entry_t *)phystokv(table_pa);
+	unsigned int index = (va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT;
+	if (index + 1 >= ARM_PGBYTES / sizeof(tt_entry_t) ||
+	    table[index] != ARM_TTE_EMPTY || table[index + 1] != ARM_TTE_EMPTY) {
+		goto unavailable;
+	}
+	const tt_entry_t flags = ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) |
+	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	table[index] = 0xAEC00000ULL | flags;
+	table[index + 1] = 0xAEE00000ULL | flags;
+	__asm__ volatile("dsb ishst" ::: "memory");
+	return va + 0xF000;
+unavailable:
+#endif
