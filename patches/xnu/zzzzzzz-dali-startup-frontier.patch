+
+/* Addresses are resolved on the host against this exact kernel artifact. */
+void
+dali_bootstrap_value(const char *label, unsigned long value)
+{
+    if (!dali_bootstrap_console) {
+        return;
+    }
+    char line[192];
+    const char prefix[] = "DALI:E ";
+    for (unsigned int index = 0; index < 7; index++) {
+        line[index] = prefix[index];
+    }
+    unsigned int at = 7, index = 0;
+    while (at < sizeof(line) - 21 && label[index]) {
+        line[at++] = label[index++];
+    }
+    if (label[index]) {
+        return;
+    }
+    line[at++] = '=';
+    line[at++] = '0';
+    line[at++] = 'x';
+    for (int shift = 60; shift >= 0; shift -= 4) {
+        unsigned int digit = (unsigned int)((value >> shift) & 15UL);
+        line[at++] = (char)(digit < 10 ? '0' + digit : 'a' + digit - 10);
+    }
+    line[at++] = '\n';
+    line[at] = 0;
+    dali_bootstrap_log(line);
+}
