--- /dev/null
+++ b/osfmk/arm64/dali_bootstrap_log.c
@@ -0,0 +1,48 @@
+/*
+ * Dali bootstrap-only persistent console. start.s publishes the base only
+ * after adding two Device-nGnRnE, PXN/UXN blocks to the existing TTBR0.
+ * No allocation, locks, formatters, per-CPU state or device register access.
+ * arm_init ends this sink before arm_vm_init can discard the identity map.
+ */
+extern volatile unsigned long dali_bootstrap_console;
+volatile unsigned long dali_bootstrap_console;
+void dali_bootstrap_log(const char *message);
+void dali_bootstrap_log_end(void);
+
+void
+dali_bootstrap_log(const char *message)
+{
+    const unsigned long base = dali_bootstrap_console;
+    if (!base) {
+        return;
+    }
+    volatile unsigned int *header = (volatile unsigned int *)base;
+    const unsigned int start = header[1];
+    if (header[0] != 0x43474244U || start != header[2] ||
+        start > 0x200000U - 12U) {
+        return;
+    }
+    const volatile unsigned char *text = (const volatile unsigned char *)message;
+    unsigned int length = 0;
+    while (length < 192U && text[length]) {
+        length++;
+    }
+    if (length == 192U || length > 0x200000U - 12U - start) {
+        return;
+    }
+    volatile unsigned char *data = (volatile unsigned char *)(base + 12U + start);
+    for (unsigned int index = 0; index < length; index++) {
+        data[index] = text[index];
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+    header[1] = start + length;
+    header[2] = start + length;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+dali_bootstrap_log_end(void)
+{
+    dali_bootstrap_console = 0;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
