# Opt-in source-only USB host-core profile. Select with `unixnu defconfig dali_usb_defconfig`
# and a separate --out directory; the normal Dali profile remains unchanged.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_SOURCE_STORAGE_FAMILY=y
CONFIG_XNU_SOURCE_HID_FAMILY=y
CONFIG_XNU_SOURCE_ENTITLEMENT_FREE=y
# CONFIG_XNU_TRUST_CACHE_RUNTIME is not set
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_NATIVE_USB_HOST=y
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/dali-xnu-platform/libDaliBootLog.a -Wl,-force_load,{tree}/build/dali-usb-host/libDaliUsbHost.a -Wl,-force_load,{tree}/build/dali-usb-storage/libDaliUsbStorage.a -Wl,-force_load,{tree}/build/source-hid/libIOHIDFamily.a -Wl,-force_load,{tree}/build/dali-usb-hid/libDaliUsbHid.a"
CONFIG_XNU_EXTRA_KERNEL_ARCHIVE_DEPENDENCIES="{tree}/build/dali-xnu-platform/libDaliBootLog.a {tree}/build/dali-usb-host/libDaliUsbHost.a {tree}/build/dali-usb-storage/libDaliUsbStorage.a {tree}/build/source-hid/libIOHIDFamily.a {tree}/build/dali-usb-hid/libDaliUsbHid.a"
